# Copy this file to .env and fill in real values. Never commit .env.
#
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Flask session signing key
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# JWT signing key (keep this different from SECRET_KEY)
JWT_SECRET_KEY=change-me-to-a-different-random-hex-string

# Database connection (MySQL / MariaDB)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost/systemhr

# Runtime
FLASK_ENV=development
UPLOAD_FOLDER=uploads

# Comma-separated list of origins allowed for CORS (avoid "*" in production)
CORS_ORIGINS=http://localhost:5000
